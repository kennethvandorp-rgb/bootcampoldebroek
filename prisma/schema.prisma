// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ContactType {
  WHATSAPP
  EMAIL
  TELEFONISCH
  INBODY
  PT_SESSIE
  OVERIG
}

enum UserRole {
  ADMIN
  TRAINER
}

// Trainer (of beheerder) die kan inloggen en klanten begeleidt.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  role         UserRole @default(TRAINER)
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       Session[]
  clients        ClientTrainer[]
  contactMoments ContactMoment[]
  scheduledTasks ScheduledTask[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Many-to-many: een klant kan door meerdere trainers tegelijk begeleid worden.
model ClientTrainer {
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainerId  String
  trainer    User     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([clientId, trainerId])
  @@index([trainerId])
}

// Gepland vervolgcontact of taak voor een trainer ("doorplannen").
model ScheduledTask {
  id              String         @id @default(cuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainerId       String
  trainer         User           @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  // Streefdatum, opgeslagen als middernacht UTC van de kalenderdag
  dueDate         DateTime
  note            String
  completed       Boolean        @default(false)
  completedAt     DateTime?
  contactMomentId String?        @unique
  contactMoment   ContactMoment? @relation(fields: [contactMomentId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([trainerId, completed, dueDate])
  @@index([clientId, completed])
}

enum GoalStatus {
  OPEN
  BEZIG
  BEHAALD
  GESTOPT
}

enum ActionItemStatus {
  OPEN
  AFGEROND
}

model Client {
  id                  String   @id @default(cuid())
  firstName           String
  lastName            String
  email               String?
  phone               String?
  birthDate           DateTime?
  startDate           DateTime @default(now())
  active              Boolean  @default(true)
  // Gedenormaliseerd: datum/tijd van het laatste contactmoment. De status
  // (groen/oranje/rood) wordt hieruit bij elke weergave berekend.
  lastContactDate     DateTime?
  ptSessionsPerWeek   Int?
  ptSessionMinutes    Int?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  contactMoments      ContactMoment[]
  inBodyMeasurements  InBodyMeasurement[]
  nutritionAnalyses   NutritionAnalysis[]
  goals               Goal[]
  actionItems         ActionItem[]
  trainers            ClientTrainer[]
  scheduledTasks      ScheduledTask[]
}

// Logt elke automatische contactmoment-controle (via de cron-endpoint), zodat
// zichtbaar is wanneer de laatste automatische waarschuwingscheck heeft gelopen.
model AutomationRun {
  id             String   @id @default(cuid())
  runAt          DateTime @default(now())
  overdueCount   Int
  dueSoonCount   Int
  neverCount     Int
  notifiedByEmail Boolean @default(false)
}

// Interactielog: elk contactmoment met een klant buiten (of tijdens) de PT-sessies.
model ContactMoment {
  id          String      @id @default(cuid())
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainerId   String?
  trainer     User?       @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  type        ContactType
  // Datum én tijd van het contact
  date        DateTime    @default(now())
  summary     String?
  notes       String?
  createdAt   DateTime    @default(now())

  inBodyMeasurement InBodyMeasurement?
  scheduledTask     ScheduledTask?

  @@index([clientId, date])
}

model InBodyMeasurement {
  id                String         @id @default(cuid())
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactMomentId   String?        @unique
  contactMoment     ContactMoment? @relation(fields: [contactMomentId], references: [id], onDelete: SetNull)
  date              DateTime       @default(now())
  weightKg          Float?
  skeletalMuscleMassKg Float?
  bodyFatPercent    Float?
  bodyFatMassKg     Float?
  bmi               Float?
  visceralFatLevel  Float?
  totalBodyWaterL   Float?
  bmrKcal           Int?
  notes             String?
  createdAt         DateTime       @default(now())

  @@index([clientId, date])
}

model NutritionAnalysis {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date          DateTime @default(now())
  kcalTarget    Int?
  proteinGrams  Int?
  carbsGrams    Int?
  fatGrams      Int?
  summary       String
  advice        String?
  createdAt     DateTime @default(now())

  @@index([clientId, date])
}

model Goal {
  id          String     @id @default(cuid())
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description String
  targetDate  DateTime?
  status      GoalStatus @default(OPEN)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  actionItems ActionItem[]

  @@index([clientId, status])
}

model ActionItem {
  id          String           @id @default(cuid())
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  goalId      String?
  goal        Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  description String
  dueDate     DateTime?
  status      ActionItemStatus @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([clientId, status])
}

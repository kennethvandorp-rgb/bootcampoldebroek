# Pad naar de SQLite-database. Gebruik indien nodig een absoluut pad
# (bijv. file:/pad/naar/project/dev.db) als je "SQLITE_READONLY"-fouten krijgt.
DATABASE_URL="file:./dev.db"

# Geheim voor de automatische contactmoment-controle (/api/cron/contact-check).
# Vul een lange willekeurige waarde in en gebruik dezelfde waarde in je externe
# scheduler (zie README).
CRON_SECRET="verander-dit-geheim"

# Optioneel: e-mailwaarschuwing bij klanten die aandacht nodig hebben.
# Zonder deze drie variabelen wordt geen mail verstuurd (de controle blijft wel
# gewoon lopen en zichtbaar op het dashboard). Zie README voor Resend-setup.
# RESEND_API_KEY="re_xxx"
# NOTIFY_EMAIL="studio@voorbeeld.nl"
# NOTIFY_FROM_EMAIL="waarschuwingen@voorbeeld.nl"
